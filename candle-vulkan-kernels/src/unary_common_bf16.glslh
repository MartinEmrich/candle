// Shared body for unary elementwise kernels (bf16 storage, f32 compute).
// Entry files must set: #version 450, then #define UN_OP(a) <expr>,
// then #include "unary_common_bf16.glslh".
//
// One thread per u32 word (two adjacent elements). Compute in f32 registers.

#include "bf16_common.glslh"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Src {
    uint data[];
} b_src;

layout(set = 0, binding = 1) buffer Dst {
    uint data[];
} b_dst;

layout(push_constant) uniform PushConstants {
    uint src_offset;
    uint dst_offset;
    uint numel;
    uint rank;
    uint dims[4];
    uint strides[4];
} pc;

uint global_index() {
    uint idx = gl_GlobalInvocationID.x;
    idx += gl_NumWorkGroups.x * gl_WorkGroupSize.x * gl_WorkGroupID.y;
    idx += gl_NumWorkGroups.x * gl_NumWorkGroups.y * gl_WorkGroupSize.x * gl_WorkGroupID.z;
    return idx;
}

uint decomp(uint idx, uint dims[4], uint strides[4], uint rank, uint offset) {
    uint off = offset;
    uint rem = idx;
    for (int d = int(rank) - 1; d >= 0; --d) {
        uint coord = rem % dims[d];
        rem /= dims[d];
        off += coord * strides[d];
    }
    return off;
}

// Abramowitz & Stegun 7.1.26, max abs error 1.5e-7.
float erf_impl(float x) {
    float sign = 1.0;
    if (x < 0.0) {
        sign = -1.0;
        x = -x;
    }
    float t = 1.0 / (1.0 + 0.3275911 * x);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
    return sign * y;
}

void main() {
    uint w = global_index();
    uint i0 = w * 2u;
    if (i0 >= pc.numel) {
        return;
    }
    uint si0 = decomp(i0, pc.dims, pc.strides, pc.rank, pc.src_offset);
    float v0 = UN_OP(BF16_LOAD(b_src.data, si0));
    uint lo = BF16_LOW(v0);
    if (i0 + 1u < pc.numel) {
        uint si1 = decomp(i0 + 1u, pc.dims, pc.strides, pc.rank, pc.src_offset);
        float v1 = UN_OP(BF16_LOAD(b_src.data, si1));
        uint hi = BF16_LOW(v1);
        b_dst.data[(pc.dst_offset + i0) >> 1u] = (hi << 16u) | lo;
    } else {
        uint wi = (pc.dst_offset + i0) >> 1u;
        uint prev = b_dst.data[wi];
        b_dst.data[wi] = (prev & 0xFFFF0000u) | lo;
    }
}
