// Tiled variable-length flash attention, f16 storage + NATIVE f16 compute.
//
// Same tiling / online-softmax algorithm as the f32-compute f16 body, but the
// hot QK^T dot runs on the hardware fp16 ALUs via f16vec4 componentwise FMAs
// instead of unpacking to f32. On parts whose fp16 rate exceeds fp32 (Xe-LPG /
// Arc, RDNA) this is a direct multiple; on fp16-at-fp32-rate parts (Xe-LP) it
// still wins a bit from 4-wide vectorisation and halved shared-memory traffic.
// The host selects this kernel over the f32-compute one only when a runtime
// benchmark shows it is faster on the actual device, so it never regresses a
// device where f32 compute is the better choice.
//
// Shared K/V are stored as float16_t (half the LDS of the f32 body -> better
// occupancy). The QK accumulator is an f16vec4 (4 lanes), so each lane sums only
// HEAD_SIZE/4 products before being reduced to f32; that keeps the fp16
// accumulation error well below the softmax resolution. The PV accumulation and
// the online softmax (running max / sum) stay in f32 for numerical safety, since
// they accumulate across the whole key sequence.
//
// Requires the `shaderFloat16` device feature (enabled host-side when present)
// and an even, compile-time HEAD_SIZE that is a multiple of 4 (set by the
// including .glsl). ALiBi is rejected host-side for narrow dtypes. Supports
// varlen, causal / sliding windows, soft-capping and GQA.
//
// q,k,v,o are contiguous [total, num_heads, head_size] (varlen packing), packed
// 2x f16 per u32.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "f16_common.glslh"
#include "fa_tiled_common.glslh"

layout(local_size_x = FA_TILE_BR, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Q { uint data[]; } b_q;
layout(set = 0, binding = 1) readonly buffer K { uint data[]; } b_k;
layout(set = 0, binding = 2) readonly buffer V { uint data[]; } b_v;
layout(set = 0, binding = 3) buffer O { uint data[]; } b_o;
layout(set = 0, binding = 4) readonly buffer CQ { uint data[]; } b_cq;
layout(set = 0, binding = 5) readonly buffer CK { uint data[]; } b_ck;
layout(set = 0, binding = 6) readonly buffer ALIBI { float data[]; } b_alibi;

layout(push_constant) uniform PushConstants {
    uint head_size;
    uint num_heads;
    uint num_heads_k;
    uint total_q;
    uint q_off;
    uint k_off;
    uint v_off;
    uint o_off;
    uint cq_off;
    uint ck_off;
    uint batch;
    int window_left;   // -1 = unbounded
    int window_right;  // -1 = unbounded (causal uses 0)
    uint has_alibi;    // 0/1 (must be 0 for narrow)
    float scale;
    float softcap;     // 0 = disabled
    uint head_base;    // first head of this launch (heads are chunked host-side)
} pc;

const uint BR = FA_TILE_BR;
const uint BC = FA_TILE_BC;
const uint HEAD = uint(HEAD_SIZE);
const uint NCHUNK = HEAD_SIZE / 4; // f16vec4 chunks spanning one head row
const float LOG2E = 1.4426950408889634;

shared float16_t ks[BC * HEAD_SIZE];
shared float16_t vs[BC * HEAD_SIZE];
shared uint red[BR];

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint seq = gl_WorkGroupID.z;
    uint head = pc.head_base + gl_WorkGroupID.y;

    uint q_start = b_cq.data[pc.cq_off + seq];
    uint q_end = b_cq.data[pc.cq_off + seq + 1u];
    uint q_token = q_start + gl_WorkGroupID.x * BR + tid;
    bool is_active = q_token < q_end;

    uint k_start = b_ck.data[pc.ck_off + seq];
    uint k_end = b_ck.data[pc.ck_off + seq + 1u];
    uint k_len = k_end - k_start;

    uint q_pos = q_token - q_start;
    uint k_lo = 0u;
    uint k_hi = k_len;
    if (is_active) {
        if (pc.window_left >= 0) {
            k_lo = (q_pos > uint(pc.window_left)) ? (q_pos - uint(pc.window_left)) : 0u;
        }
        if (pc.window_right >= 0) {
            uint hi = q_pos + uint(pc.window_right) + 1u;
            k_hi = min(k_len, hi);
        }
    }

    uint kv_head = head / (pc.num_heads / pc.num_heads_k);
    uint kv_stride = pc.num_heads_k * HEAD;
    uint q_stride = pc.num_heads * HEAD;
    uint q_base = pc.q_off + q_token * q_stride + head * HEAD;
    uint k_base = pc.k_off + k_start * kv_stride + kv_head * HEAD;
    uint v_base = pc.v_off + k_start * kv_stride + kv_head * HEAD;
    uint o_base = pc.o_off + q_token * q_stride + head * HEAD;

    // Workgroup key range = union of active rows' [k_lo, k_hi). Inactive rows
    // contribute neutral bounds so they don't widen the range.
    red[tid] = is_active ? k_lo : k_len;
    barrier();
    for (uint s = BR / 2u; s > 0u; s /= 2u) {
        if (tid < s) {
            red[tid] = min(red[tid], red[tid + s]);
        }
        barrier();
    }
    uint tile_lo = red[0];
    barrier();
    red[tid] = is_active ? k_hi : 0u;
    barrier();
    for (uint s = BR / 2u; s > 0u; s /= 2u) {
        if (tid < s) {
            red[tid] = max(red[tid], red[tid + s]);
        }
        barrier();
    }
    uint tile_hi = red[0];
    barrier();

    // Query row kept register-resident as f16vec4 chunks (halves the register
    // footprint vs the f32 body). PV accumulator stays f32.
    f16vec4 qv[NCHUNK];
    float acc[HEAD_SIZE];
    float m = -(1.0 / 0.0);
    float l = 0.0;
    if (is_active) {
        for (uint c = 0u; c < NCHUNK; ++c) {
            uint b = q_base + c * 4u;
            qv[c] = f16vec4(
                float16_t(F16_LOAD(b_q.data, b + 0u)),
                float16_t(F16_LOAD(b_q.data, b + 1u)),
                float16_t(F16_LOAD(b_q.data, b + 2u)),
                float16_t(F16_LOAD(b_q.data, b + 3u))
            );
        }
        for (uint d = 0u; d < HEAD; ++d) {
            acc[d] = 0.0;
        }
    }

    uint nload = (BC * HEAD + BR - 1u) / BR;

    for (uint kt0 = tile_lo; kt0 < tile_hi; kt0 += BC) {
        // Cooperative load of K/V rows [kt0, kt0 + BC) into shared memory (f16).
        for (uint i = 0u; i < nload; ++i) {
            uint idx = tid + i * BR;
            if (idx < BC * HEAD) {
                uint r = idx / HEAD;
                uint dc = idx % HEAD;
                uint kt = kt0 + r;
                float16_t kv = float16_t(0.0);
                float16_t vv = float16_t(0.0);
                if (kt < k_len) {
                    uint kb = k_base + kt * kv_stride;
                    uint vb = v_base + kt * kv_stride;
                    kv = float16_t(F16_LOAD(b_k.data, kb + dc));
                    vv = float16_t(F16_LOAD(b_v.data, vb + dc));
                }
                ks[r * HEAD_SIZE + dc] = kv;
                vs[r * HEAD_SIZE + dc] = vv;
            }
        }
        barrier();

        uint kend = min(kt0 + BC, tile_hi);
        for (uint kt = kt0; kt < kend; ++kt) {
            if (!is_active || kt < k_lo || kt >= k_hi) {
                continue;
            }
            uint krow = (kt - kt0) * HEAD_SIZE;
            // QK dot on the fp16 ALUs: 4-lane accumulator, one f16vec4 FMA per
            // chunk, so each lane sums NCHUNK products before the f32 reduce.
            f16vec4 sacc = f16vec4(0.0);
            for (uint c = 0u; c < NCHUNK; ++c) {
                uint kr = krow + c * 4u;
                f16vec4 kv = f16vec4(
                    ks[kr + 0u], ks[kr + 1u], ks[kr + 2u], ks[kr + 3u]
                );
                sacc += qv[c] * kv;
            }
            float s = float(sacc.x) + float(sacc.y) + float(sacc.z) + float(sacc.w);
            s *= pc.scale;
            if (pc.softcap > 0.0) {
                s = pc.softcap * tanh(s / pc.softcap);
            }
            float m_new = max(m, s);
            float corr = exp2((m - m_new) * LOG2E);
            float p = exp2((s - m_new) * LOG2E);
            l = l * corr + p;
            for (uint d = 0u; d < HEAD; ++d) {
                acc[d] = acc[d] * corr + p * float(vs[krow + d]);
            }
            m = m_new;
        }
        barrier();
    }

    if (is_active) {
        float inv_l = (l > 0.0) ? (1.0 / l) : 0.0;
        for (uint d = 0u; d < HEAD; d += 2u) {
            uint word = (o_base + d) >> 1u;
            uint lo = F16_LOW(acc[d] * inv_l);
            uint hi = F16_LOW(acc[d + 1u] * inv_l);
            b_o.data[word] = (hi << 16u) | lo;
        }
    }
}
